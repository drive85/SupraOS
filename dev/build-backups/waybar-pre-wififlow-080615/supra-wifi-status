#!/bin/sh
# SupraOS wifi status: phone-style signal bars for waybar (JSON, 5s interval)
IFACE=wlan0
B1=$(printf '\342\226\202'); B2=$(printf '\342\226\204'); B3=$(printf '\342\226\206'); B4=$(printf '\342\226\210')

line=$(awk -v i="$IFACE:" '$1==i' /proc/net/wireless 2>/dev/null)
if [ -z "$line" ]; then
  printf '{"text": " Wi-Fi: Off", "tooltip": "disconnected", "class": "wifi-off"}\n'
  exit 0
fi

level=$(printf '%s' "$line" | awk '{gsub(/[.]/,"",$4); print $4}')
link=$(printf '%s' "$line" | awk '{gsub(/[.]/,"",$3); print $3}')
level=${level:--100}
link=${link:-0}
pct=$(( link * 100 / 70 ))
[ "$pct" -gt 100 ] && pct=100

if   [ "$level" -ge -55 ]; then n=4
elif [ "$level" -ge -67 ]; then n=3
elif [ "$level" -ge -72 ]; then n=2
elif [ "$level" -ge -80 ]; then n=1
else n=1
fi

bars=""
i=1
for b in "$B1" "$B2" "$B3" "$B4"; do
  if [ "$i" -le "$n" ]; then
    bars="$bars$b"
  else
    bars="$bars<span color='#3a3a3a'>$b</span>"
  fi
  i=$(( i + 1 ))
done

essid=$(wpa_cli -i "$IFACE" status 2>/dev/null | awk -F= '/^ssid=/{print $2}' | tr -d '"')
essid=${essid:-unknown}
ip=$(ip -4 addr show "$IFACE" 2>/dev/null | awk '/inet /{split($2,a,"/"); print a[1]}')

printf '{"text": "%s", "tooltip": "%s  -  %s  -  signal %d%%  (%d dBm)", "class": "wifi"}\n' \
  "$bars" "${essid:-unknown}" "${ip:-no ip}" "$pct" "$level"
