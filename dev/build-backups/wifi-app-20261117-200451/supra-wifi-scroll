#!/bin/sh
# SupraOS wifi scroll: move the tooltip selection up/down
PATH=/usr/sbin:/usr/bin:/sbin:/bin
D=$HOME/.cache/supra-wifi
mkdir -p "$D"
[ -s "$D/networks" ] || exit 0
total=$(wc -l < "$D/networks")
idx=$(cat "$D/idx" 2>/dev/null)
idx=${idx:-1}
case "$1" in
  up)   idx=$(( idx + 1 )); [ "$idx" -gt "$total" ] && idx=1 ;;
  down) idx=$(( idx - 1 )); [ "$idx" -lt 1 ] && idx=$total ;;
  *) exit 0 ;;
esac
echo "$idx" > "$D/idx"
