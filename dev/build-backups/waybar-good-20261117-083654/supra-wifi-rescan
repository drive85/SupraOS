#!/bin/sh
# SupraOS wifi rescan: refresh available-networks cache (runs in background)
PATH=/usr/sbin:/usr/bin:/sbin:/bin
D=$HOME/.cache/supra-wifi
mkdir -p "$D"
IFACE=wlan0

wpa_cli -i "$IFACE" scan >/dev/null 2>&1 || exit 0
sleep 3
wpa_cli -i "$IFACE" scan_results 2>/dev/null | awk -F'\t' 'NR>1 && $5!="" {
  gsub(/^[ \t]+|[ \t]+$/, "", $5)
  gsub(/["\\]/, "", $5)
  if ($5 != "") print $5 "\t" $4 "\t" int($3 + 200)
}' | sort -t"$(printf '\t')" -k3 -rn | awk -F'\t' '!seen[$1]++' > "$D/networks.tmp"
mv "$D/networks.tmp" "$D/networks"
echo 1 > "$D/idx"
