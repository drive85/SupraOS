#!/bin/sh
# SupraOS wifi menu: click bars -> foot popup at the bars, mouse-driven fzf list
PATH=/usr/sbin:/usr/bin:/sbin:/bin
D=$HOME/.cache/supra-wifi
IFACE=wlan0

if [ "$1" != "inner" ]; then
  setsid foot -a wifimenu -W 34x12 -o main.pad=8x8 \
    -e /home/erick/.local/bin/supra-wifi-menu inner >/dev/null 2>&1 &
  sleep 0.4
  swaymsg "[app_id=\"wifimenu\"] floating enable, move position mouse, move down 24px, move left 120px" >/dev/null 2>&1
  exit 0
fi

# ---- inner: runs inside the foot window ----
[ -s "$D/networks" ] || ~/.local/bin/supra-wifi-rescan

if ! command -v fzf >/dev/null 2>&1; then
  echo "one-time setup: installing fzf (root password)"
  su -c "apk add fzf" || { echo "install failed"; sleep 3; exit 1; }
  clear
fi

W="wpa_cli -i $IFACE"
cur=$($W status 2>/dev/null | awk -F= '/^ssid=/{print $2}')
B1=$(printf '\342\226\202'); B2=$(printf '\342\226\204'); B3=$(printf '\342\226\206'); B4=$(printf '\342\226\210')
GT=$(printf '\033[90m'); R=$(printf '\033[0m'); G=$(printf '\033[92m')

menu=""
while IFS="$(printf '\t')" read -r ssid flags sig; do
  [ -z "$ssid" ] && continue
  if   [ "$sig" -ge 145 ]; then k=4
  elif [ "$sig" -ge 133 ]; then k=3
  elif [ "$sig" -ge 128 ]; then k=2
  elif [ "$sig" -ge 120 ]; then k=1
  else k=1
  fi
  row=""
  j=1
  for b in "$B1" "$B2" "$B3" "$B4"; do
    if [ "$j" -le "$k" ]; then row="$row$b"; else row="$row$GT$b$R"; fi
    j=$(( j + 1 ))
  done
  star=""
  [ "$ssid" = "$cur" ] && star=" $G""connected""$R"
  menu="$menu$row  $ssid$star
"
done < "$D/networks"

[ -z "$menu" ] && { echo "no networks found - right-click bars to rescan"; sleep 3; exit 0; }

export FZF_DEFAULT_OPTS="--color=bg:#000000,fg:#e8e6df,hl:#e8e6df,fg+:#000000,bg+:#e8e6df,hl+:#000000,pointer:#e8e6df,prompt:#3a3a3a,info:#3a3a3a,border:#3a3a3a --prompt= --pointer=> --no-sort --cycle --no-info --no-multi"

sel=$(printf '%s' "$menu" | timeout 30 fzf --ansi 2>/dev/null)
[ -z "$sel" ] && exit 0

name=$(printf '%s' "$sel" | sed 's/^[^ ]* //; s/ connected$//')
flags=$(awk -F'\t' -v s="$name" '$1==s{print $2}' "$D/networks")
[ "$name" = "$cur" ] && { echo "already connected"; sleep 1; exit 0; }

id=$($W list_networks 2>/dev/null | awk -F'\t' -v s="$name" '$2==s{print $1; exit}')
if [ -n "$id" ]; then
  $W select_network "$id" >/dev/null 2>&1
else
  case "$flags" in
    *WPA*|*RSN*|*WEP*)
      printf 'PSK for %s: ' "$name"
      stty -echo 2>/dev/null
      read -r psk
      stty echo 2>/dev/null
      echo
      ;;
    *)
      psk=""
      ;;
  esac
  newid=$($W add_network 2>/dev/null | tr -d '"')
  [ -z "$newid" ] && { echo "wpa error"; sleep 2; exit 1; }
  $W set_network "$newid" ssid "\"$name\"" >/dev/null 2>&1
  if [ -n "$psk" ]; then
    $W set_network "$newid" psk "\"$psk\"" >/dev/null 2>&1
  elif printf '%s' "$flags" | grep -q 'WPA\|RSN\|WEP'; then
    $W remove_network "$newid" >/dev/null 2>&1
    echo "canceled"
    sleep 1
    exit 0
  else
    $W set_network "$newid" key_mgmt NONE >/dev/null 2>&1
  fi
  $W select_network "$newid" >/dev/null 2>&1
  $W save_config >/dev/null 2>&1
fi

echo "connecting to $name ..."
setsid ~/.local/bin/supra-wifi-rescan >/dev/null 2>&1 &
sleep 2
