#!/bin/sh
# SupraOS wifi bar toggle: close the popup if open, else open it.
# (BusyBox pkill -x matches argv[0], so a pidfile is the reliable way.)
D=$HOME/.cache/supra-wifi
mkdir -p "$D"
P="$D/app.pid"
if [ -s "$P" ] && kill -0 "$(cat "$P")" 2>/dev/null; then
  kill "$(cat "$P")"
  exit 0
fi
setsid ~/.local/bin/supra-wifi-app >/dev/null 2>&1 &
exit 0
