#!/bin/sh
# SupraOS wifi bars module: signal bars only (popup app carries the network list)
PATH=/usr/sbin:/usr/bin:/sbin:/bin
IFACE=wlan0
B1=$(printf '\342\226\202'); B2=$(printf '\342\226\204'); B3=$(printf '\342\226\206'); B4=$(printf '\342\226\210')
DIM=$(printf "<span color='#3a3a3a'>")
CLOSE='</span>'

line=$(awk -v i="$IFACE:" '$1==i' /proc/net/wireless 2>/dev/null)
connected="no"
level="-100"
if [ -n "$line" ]; then
  level=$(printf '%s' "$line" | awk '{gsub(/[.]/,"",$4); print $4}')
  level=${level:--100}
  essid=$(wpa_cli -i "$IFACE" status 2>/dev/null | awk -F= '/^ssid=/{print $2}' | tr -d '"')
  [ -n "$essid" ] && connected="yes"
fi

if   [ "$level" -ge -55 ]; then n=4
elif [ "$level" -ge -67 ]; then n=3
elif [ "$level" -ge -72 ]; then n=2
elif [ "$level" -ge -80 ]; then n=1
else n=1
fi

bars=""
i=1
for b in "$B1" "$B2" "$B3" "$B4"; do
  if [ "$connected" = "yes" ] && [ "$i" -le "$n" ]; then
    bars="$bars$b"
  else
    bars="$bars$DIM$b$CLOSE"
  fi
  i=$(( i + 1 ))
done

printf '{"text": " %s", "class": "wifi"}\n' "$bars"
